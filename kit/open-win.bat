@echo off
chcp 65001 >nul
rem Запуск двойным щелчком ВНУТРИ zip: Windows кладёт во временную папку один
rem этот .bat, без скрипта и tdata. Ловим это сразу и объясняем по-русски.
if exist "%~dp0open-win.ps1" (
  powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0open-win.ps1"
  echo.
  echo ----------------------------------------------------------
  echo  Это окно можно закрыть — Telegram, если открылся, останется.
  echo  Если Telegram НЕ открылся, пришли скрин ВСЕГО этого окна.
  echo ----------------------------------------------------------
) else (
  echo.
  echo  СТОП: этот файл запущен прямо из архива.
  echo  Windows вытащил только его, а аккаунт и скрипты остались внутри архива.
  echo.
  echo  Как правильно:
  echo    1. Закрой это окно.
  echo    2. Правой кнопкой по скачанному архиву — «Извлечь все...» — «Извлечь».
  echo    3. Откроется распакованная папка — запусти этот же файл уже в ней.
  echo.
)
pause
